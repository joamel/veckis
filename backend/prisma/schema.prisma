generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Household {
  id        String   @id @default(cuid())
  name      String
  emoji     String?  @default("🏠")
  // Receptlistans fästa taggar, i den ordning de fästes. Ligger först i
  // taggraden, före resten som sorteras på antal recept. Delas av hushållet.
  pinnedRecipeTags String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       HouseholdMember[]
  inviteCodes   InviteCode[]
  shoppingLists ShoppingList[]
  stores        Store[]
  recipes       Recipe[]
  weekMenuItems WeekMenuItem[]
  stapleItems   StapleItem[]
  menuTemplates MenuTemplate[]
  hiddenSuggestions HiddenSuggestion[]
}

model HouseholdMember {
  id          String   @id @default(cuid())
  householdId String
  clerkUserId String?
  displayName String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, clerkUserId])
  @@index([clerkUserId])
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  householdId String
  createdBy   String
  expiresAt   DateTime
  usedAt      DateTime?
  usedBy      String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([code])
}

model Store {
  id                String        @id @default(cuid())
  householdId       String
  name              String
  categoryOrder     StoreCategory[]
  customCategories  String[]      @default([])
  // Subs som hushållet brutit ut som egna sektioner under sin parent.
  // Övriga items grupperas under parent som idag. Strängar refererar till
  // SubCategory-värden i shared/lib/taxonomy.ts.
  expandedSubs      String[]      @default([])
  // Ordning för STANDARD-subs som INTE är utbrutna (ej i expandedSubs) — så
  // hushållet kan förbereda sorteringen innan man bockar i/visar en sub.
  // Innehåller bara SubCategory-strängar (inga "cs:"-kodade egna, de skapas
  // alltid redan utbrutna). Filtreras per parent via SUB_TAXONOMY vid render;
  // saknade poster faller tillbaka på taxonomins standardordning.
  subOrder          String[]      @default([])
  // UTFASAD 2026-09-30: egna underkategorier borttagna, alltid {}. Kolumnen tas
  // bort senare. Var: hushålls-lokala egna underkategorier { parentKey: [subLabel, ...] } där
  // parentKey är en StoreCategory ELLER "c:<egen kategori>". Ordningen styr
  // plocklistan. Rent lokalt — matar aldrig den globala kategori-inlärningen.
  customSubs        Json          @default("{}")
  // Enhetlig parent-ordning som blandar standard-kategorier (StoreCategory) och
  // egna kategorier ("c:<egen kategori>") i EN lista. Styr plocklistans ordning.
  // Tom = härled från categoryOrder (standard) + customCategories (sist) för
  // bakåtkompat.
  parentOrder       String[]      @default([])
  // Kategori-ihopslagning: { sourceKey: targetKey } där sourceKey är en
  // StoreCategory som (i stället för att bara döljas) slås ihop med en
  // ANNAN synlig kategori i just den här butiken — varans egna category-
  // fält ändras ALDRIG, bara vilken sektion den grupperas under vid
  // visning. sourceKey tas bort ur parentOrder när den läggs till här.
  // Enkel v1 (2026-09-07): bara standard-kategorier som källa (samma
  // begränsning som "dölj" redan har), ingen kedjning.
  categoryMerge     Json          @default("{}")
  // Butikens egna namn på kategorier och rubriker: { StoreCategory | "c:<rubrik>": namn }
  // ("Skafferi" på ICA, "Torrvaror" på Coop). Bara rubriken — varans kategori
  // är densamma i alla butiker.
  categoryLabels    Json          @default("{}")
  // Kopplingen till en butik i butiksbanken. null = en egen butik, som förut.
  // SetNull: försvinner butiken ur banken blir den en egen butik igen, med
  // hushållets ordning orörd.
  sharedStoreId     String?
  createdAt         DateTime      @default(now())

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sharedStore   SharedStore?   @relation(fields: [sharedStoreId], references: [id], onDelete: SetNull)
  shoppingLists ShoppingList[]
  checkEvents   ShoppingCheckEvent[]

  @@index([sharedStoreId])
  // En butik ur banken finns högst EN gång per hushåll — annars fick samma
  // fysiska butik två olika ordningar, och inlärningen visste inte vilken som
  // gällde. Egna butiker (sharedStoreId null) påverkas inte: i Postgres är
  // NULL aldrig lika med NULL i ett unikt index.
  @@unique([householdId, sharedStoreId])
}

// Butiksbanken: svenska matbutiker från OpenStreetMap (© OSM-bidragsgivare,
// ODbL — källan ska anges där listan visas). Läses in med
// scripts/import-osm-stores.ts. Se lib/sharedStores.ts.
model SharedStore {
  id        String   @id @default(cuid())
  // "node/123" eller "way/456" — stabilt id i OSM, nyckeln vid omläsning.
  osmId     String   @unique
  name      String
  chain     String?
  street    String?
  postcode  String?
  city      String?
  // Postorten ur OSM (addr:city). city ovan är orten som VISAS — i
  // storstäderna stadsdelen ("Liljeholmen, Stockholm") — och kan skilja sig.
  postalCity String?
  lat       Float
  lon       Float
  updatedAt DateTime @updatedAt

  stores Store[]
}

// En bockad vara i en lista med butik — råmaterial för att lära sig i vilken
// ordning butiken handlas. Se lib/checkEvents.ts för varför fälten ser ut som
// de gör. Inget varunamn och inget användar-id sparas: bara var i butiken
// (kategori och underkategori), en pseudonym nyckel och när.
model ShoppingCheckEvent {
  id                String   @id @default(cuid())
  storeId           String
  shopperKey        String
  category          String
  subCategory       String?
  customCategory    String?
  customSubCategory String?
  checkedAt         DateTime
  // "Markera alla i kategorin" — inte en väg genom butiken.
  bulk              Boolean  @default(false)
  createdAt         DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, checkedAt])
}

model ShoppingList {
  id          String    @id @default(cuid())
  householdId String
  name        String
  emoji       String?
  storeId     String?
  isShared    Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  // "Jag handlar"-presence: vem som aktivt handlar listan just nu. Sätts av
  // användaren själv via PATCH /shopping-lists/:id/shopper och rensas
  // manuellt eller automatiskt vid clear/complete. Andra hushållsmedlemmar
  // ser en markör så ingen råkar göra dubbla turer till affären.
  activeShopperMemberId String?
  activeShopperSince    DateTime?

  household Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  store     Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items     ShoppingItem[]

  @@index([householdId])
}

model ShoppingItem {
  id           String        @id @default(cuid())
  listId       String
  name         String
  quantity     Float         @default(1)
  unit         String?
  category     StoreCategory @default(other)
  // 2-nivå-taxonomi: subCategory är källa till sanning för aggregering/AI/sök;
  // category är parent (sub:ens defaultParent vid skapande, kan override:as
  // per item). Skickas som string för att frikoppla från enum-deploys —
  // shared/lib/taxonomy.ts håller listan över giltiga värden.
  subCategory  String?
  customCategory String?  // UTFASAD 2026-09-30 (egna kategorier är butikens rubriker, aldrig data på varan) — alltid null, tas bort senare
  customSubCategory String? // UTFASAD 2026-09-30 (egna underkategorier borttagna) — alltid null, kolumnen tas bort senare
  isChecked    Boolean       @default(false)
  checkedBy    String?
  addedBy      String
  note         String?
  recipeId     String?
  menuItemId   String?
  mergedIntoId String?
  createdAt    DateTime      @default(now())

  list         ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  recipe       Recipe?        @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  mergedInto   ShoppingItem?  @relation("MergeChildren", fields: [mergedIntoId], references: [id], onDelete: Cascade)
  mergeSources ShoppingItem[] @relation("MergeChildren")

  @@index([listId])
  @@index([menuItemId])
  @@index([mergedIntoId])
}

model Recipe {
  id          String   @id @default(cuid())
  householdId String
  title       String
  description String?
  instructions String?
  // Stegen som KÄLLAN skrev dem, satt bara när importen översatte texten.
  // Samma mönster som RecipeIngredient.originalName: ↔-knappen växlar mellan
  // instructions och den här.
  originalInstructions String?
  sourceUrl   String?
  // Hur receptet skapades: 'manual' (eget), 'ai_paste' (AI ur inklistrad text,
  // ingen bild), 'url_import' (skrapat från URL — kan innehålla tredje parts
  // hotlinkade bild + beskrivning). Används för att gate:a framtida delning:
  // bara manual/ai_paste bör kunna delas vidare, aldrig url_import.
  source      String   @default("manual")
  imageUrl    String?
  imagePublicId String?  // Cloudinary public_id for the uploaded image, so we can delete it on change/recipe-delete
  // Vilken del av bilden som ska synas när den beskärs till 16:9 vid visning.
  // 0 = vänster/överkant, 1 = höger/nederkant, null = mitten (som förut).
  // Sparas i stället för att beskära filen: originalet blir kvar, justeringen
  // går att ändra hur många gånger som helst, och den fungerar även för
  // URL-importerade bilder som ligger hos tredje part och inte kan beskäras.
  imageFocusX Float?
  imageFocusY Float?
  // Inzoomning utöver den skala som precis täcker ramen. null = 1 = ingen
  // zoom (som förut). Låter en inbakad vit kant eller ett för brett motiv
  // zoomas bort — att bara flytta bilden räcker inte till det.
  imageZoom   Float?
  // Total tillagningstid i minuter, som receptet självt anger den (JSON-LD
  // totalTime/cookTime+prepTime, AI-tolkning eller handskriven). null = okänd;
  // gissas aldrig fram.
  cookMinutes Int?
  servings    Int      @default(4)
  timesUsed   Int      @default(0)
  // Fritt taggbara etiketter ("vegetariskt", "snabbt", "favorit" …) —
  // gemener/trimmade, används för filtrering i receptlistan.
  tags        String[] @default([])
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household     Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredients   RecipeIngredient[]
  weekMenuItems WeekMenuItem[]
  shoppingItems ShoppingItem[]
  menuTemplateItems MenuTemplateItem[]

  @@index([householdId])
}

model RecipeIngredient {
  id       String        @id @default(cuid())
  recipeId String
  name     String
  quantity Float?
  unit     String?
  category StoreCategory @default(other)

  // Ingrediensnamnet exakt som KÄLLAN skrev det, satt bara när importen
  // översatte namnet ("all-purpose flour" → "vetemjöl"). null för allt som
  // redan var svenskt, skrevs in för hand eller importerades innan fältet
  // fanns. Receptvyns ↔-knapp växlar mellan name och originalName.
  originalName String?

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model WeekMenuItem {
  id          String   @id @default(cuid())
  householdId String
  recipeId    String
  day         WeekDay?
  mealType    String?  // 'breakfast' | 'lunch' | 'dinner' | 'dessert' | null — låter flera rätter samsas per dag
  weekYear    Int
  weekNumber  Int
  note        String?
  servings     Int?     // per-placement portion scaling; null = use recipe default
  transferred  Boolean  @default(false) // set when ingredients have been sent to a shopping list
  createdBy   String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([householdId, weekYear, weekNumber])
}

model MenuTemplate {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdBy   String
  createdAt   DateTime @default(now())

  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     MenuTemplateItem[]

  @@index([householdId])
}

model MenuTemplateItem {
  id         String   @id @default(cuid())
  templateId String
  recipeId   String
  day        WeekDay?

  template MenuTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  recipe   Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model StapleItem {
  id              String        @id @default(cuid())
  householdId     String
  name            String
  category        StoreCategory @default(other)
  // Hushållets val av underkategori för varan, satt i basvaru-editorn
  // (långtryck på ett sökförslag). null = inget val gjort, då får
  // inferSubCategory gissa vid tillägg. Sträng av samma skäl som
  // ShoppingItem.subCategory: frikopplad från enum-deploys.
  subCategory     String?
  // Valde hushållet kategorin (true), eller är den klassarens gissning från
  // när basvaran skapades (false)? Bara ett val får gå före den kurerade
  // kedjan — en gissning som lästes som ett val lade kakao under Bröd i fem
  // hushåll. null = basvaran skapades före 2026-09-30; backfillStapleChoice
  // avgör vid start om den sparade kategorin ser ut som en gammal gissning.
  categoryChosen  Boolean?
  unit            String?
  defaultQuantity Float?
  usageCount      Int           @default(0) // times added to a list — drives "dina vanligaste"

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId])
}

// Per-hushåll dolda sök-/ingrediensförslag. Namnet (normaliserat lowercase)
// filtreras bort ur /api/staples/suggestions så en feltolkad global alias
// ("10 msk kako") eller felaktig basvara aldrig dyker upp som förslag för
// hushållet. Global IngredientAlias rörs ALDRIG (den delas av alla hushåll).
model HiddenSuggestion {
  id          String   @id @default(cuid())
  householdId String
  name        String
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, name])
  @@index([householdId])
}

model IngredientAlias {
  raw       String        @id
  canonical String
  category  StoreCategory @default(other)
  seenCount Int           @default(1)

  @@index([canonical])
}

// Vilka hushåll som sett ett givet ingrediensnamn — grunden för att kunna kräva
// ≥N DISTINKTA hushåll (inte bara N totala förekomster) innan namnet syns
// globalt för andra. Avstängt under betan (se MIN_HOUSEHOLDS_FOR_GLOBAL_SUGGESTION
// i staples.ts) men börjar samla data redan nu.
model IngredientAliasHousehold {
  raw         String
  householdId String
  createdAt   DateTime @default(now())

  @@id([raw, householdId])
}

// Global förpacknings-kunskap: "1 paket krossade tomater ≈ 400 g".
// name = kanoniskt gemener-namn (stripIngredient-output), unit = förpacknings-
// enhet ("paket","burk","påse",…). source: 'seed' | 'ai' | 'user' — 'user'
// betyder bekräftad av en riktig ihopslagning (Fas 2-kriterium för auto-merge).
model UnitEquivalence {
  id         String   @id @default(cuid())
  name       String
  unit       String
  baseAmount Float
  baseUnit   String // 'g' | 'ml'
  source     String   @default("ai")
  seenCount  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([name, unit])
  @@index([name])
}

// One row per device/token. A user (clerkUserId) may have several.
model PushToken {
  id          String   @id @default(cuid())
  clerkUserId String
  token       String   @unique
  platform    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
}

// Per-user push preferences (global across households). Defaults all on.
model NotificationPreference {
  clerkUserId      String   @id
  listCleared      Boolean  @default(true)
  newMember        Boolean  @default(true)
  shopperClaimed   Boolean  @default(true)
  shopperItemAdded Boolean  @default(true) // vara tillagd medan man handlar
  updatedAt        DateTime @updatedAt
}

// Dedupe ledger for time-based notifications so a reminder fires once per
// occurrence. `dedupeKey` encodes type + entity + occurrence date/time.
model NotificationLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  sentAt    DateTime @default(now())

  @@index([sentAt])
}

// Auditspår för känsliga handlingar — vem raderade hushållet, vem
// tog bort en medlem, vem ändrade en roll. Sökbart per hushåll/aktör
// så vi kan svara på "vem gjorde vad" om en användare ifrågasätter.
//
// Ingen FK till Household/HouseholdMember för att raderingar fortsatt
// ska kunna logga — vi behöver loggraden EFTER att target raderats.
model AuditLog {
  id          String   @id @default(cuid())
  householdId String?  // null för system-events utanför ett hushåll
  actorClerkUserId String  // vem som utförde
  actorName   String?  // snapshot av display-namn vid handlingen
  action      String   // ex: "household.delete", "member.remove", "member.role_change"
  targetType  String?  // "household" | "member" | osv
  targetId    String?  // id på det som ändrades
  targetName  String?  // snapshot (för bortagna entiteter)
  metadata    Json?    // valfri extra info: gammalt/nytt värde, anledning
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
  @@index([actorClerkUserId, createdAt])
}

enum MemberRole {
  admin
  member
}

enum StoreCategory {
  fruit_veg
  meat_fish
  deli_charcuterie
  cheese
  dairy_eggs
  bread_bakery
  frozen
  canned_dry
  snacks_sweets
  beverages
  special_diet
  cleaning
  personal_care
  baby_kids
  other
}

enum WeekDay {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

/// Löpande AI-kostnad per kalendermånad. Finns för att kostnaden ska gå att se
/// och larma på — en räknare i processminnet nollställs vid varje omdeploy, och
/// Railway deployar ofta.
///
/// En rad per månad, uppdaterad efter varje AI-anrop. Ingen koppling till
/// hushåll: syftet är den totala notan, inte vem som orsakade den.
model AiUsage {
  /// "2026-09" — kalendermånad i UTC.
  month        String   @id
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// Ackumulerad kostnad i ÖRE. Heltal — flyttal och pengar hör inte ihop.
  costOre      Int      @default(0)
  /// Sätts när månadens varningsgräns passerats, så larmet bara går en gång.
  warnedAt     DateTime?
  updatedAt    DateTime @updatedAt
}

/// Månadstak för fototolkning, per användare.
///
/// Det globala kostnadslarmet skyddar notan men inte de andra användarna: hinner
/// någon fota in en hel kokbok innan larmet går, står alla utan funktionen. Det
/// här taket gör att en enskild användare inte kan förstöra för resten.
///
/// Räknas per Clerk-användare och inte per hushåll, eftersom from-photo-routen
/// inte får något hushålls-id — receptet skapas i ett separat anrop efteråt.
model PhotoQuota {
  clerkUserId String
  /// "2026-09" — kalendermånad i UTC.
  month       String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([clerkUserId, month])
}

// Handskrivna klassningar från adminsidan: varunamn → kategori (+ underkategori).
// Ligger FÖRST i klassaren, före undantagen i koden. Kurerat, inte inlärt —
// bara appadmin skriver hit, och varje ändring loggas i AuditLog. Läses in i
// minnet vid start och efter varje ändring (lib/curatedOverrides.ts), eftersom
// klassaren är synkron.
model CuratedCategory {
  name        String        @id // gemener, som varunamnen i listorna
  category    StoreCategory
  subCategory String?
  updatedBy   String
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
}

// Varunamn som adminsidan dolt för andra hushåll ("Dölj för andra"). Namnet
// föreslås aldrig globalt — inte heller om det lärs in igen — men hushåll som
// har det som basvara behåller det. Radera överallt är något annat: skräp.
model HiddenGlobalName {
  name      String   @id // gemener
  hiddenBy  String
  createdAt DateTime @default(now())
}

// Förslag adminen bockat ur i ett städjobb eller i Städförslag — föreslås inte
// igen. scope = jobbets id eller "names"; key = radens nyckel.
model IgnoredSuggestion {
  scope     String
  key       String
  createdAt DateTime @default(now())

  @@id([scope, key])
}
