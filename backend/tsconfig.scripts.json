{
  // Städskripten låg utanför typkontrollen (tsconfig tar bara med "src"), och
  // en odeklarerad variabel i clean-mangdprefix.ts upptäcktes först när
  // skriptet kraschade MITT I en skarp körning — efter att ändringarna redan
  // skrivits. De körs med tsx och byggs aldrig, så den här konfigurationen
  // finns bara för att kunna säga `npm run typecheck:scripts`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // rootDir ärvs som "src" och skulle avvisa varje fil i scripts/. Inget
    // byggs här, så roten är hela projektet.
    "rootDir": ".",
    // Skripten körs av tsx på Node 24, inte av bygget. ES2022 ger dem
    // `new Error(msg, { cause })`, som cleanup-members redan använder.
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["scripts", "src"],
  "exclude": ["node_modules", "dist"]
}
