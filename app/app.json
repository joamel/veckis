{
  "expo": {
    "name": "Handlis",
    "slug": "veckis",
    "version": "2.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/37425b58-c8af-45be-aac8-c26bbdfaa3d1",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "default",
    "scheme": "handlis",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#cddcb3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.handlis.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "sv",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.handlis.app",
      "versionCode": 22,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#cddcb3"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#292524",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "@clerk/expo",
      "expo-apple-authentication",
      "./plugins/withDisableAutofill",
      "./plugins/withSingleTask",
      "./plugins/withUnlockScannerOrientation",
      [
        "expo-image-picker",
        {
          "photosPermission": "Handlis behöver tillgång till dina bilder för att välja receptbild.",
          "cameraPermission": "Handlis behöver kameran för att ta en receptbild."
        }
      ],
      "@clerk/expo-google-signin",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Handlis använder din ungefärliga position för att visa de matbutiker som ligger närmast dig.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.clerk.** { *; }\n-keep class androidx.credentials.** { *; }\n-keep class com.google.android.libraries.identity.googleid.** { *; }\n-keepattributes Signature,*Annotation*,InnerClasses,EnclosingMethod,Exceptions\n-keep,allowobfuscation,allowshrinking interface retrofit2.Call\n-keep,allowobfuscation,allowshrinking class retrofit2.Response\n-keep,allowobfuscation,allowshrinking class kotlin.coroutines.Continuation\n-keepclassmembers class * { @kotlinx.serialization.Serializable *; }\n-keep class **$$serializer { *; }\n-keepclassmembers @kotlinx.serialization.Serializable class ** { *** Companion; kotlinx.serialization.KSerializer serializer(...); }\n-dontwarn com.clerk.**"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37425b58-c8af-45be-aac8-c26bbdfaa3d1"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "630229510172-1nb18ugbraqrrqqcqgvvhblonslccr4f.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "630229510172-o5si76i2ce137204dtnbrjqbjmbccleq.apps.googleusercontent.com"
    },
    "owner": "joamel"
  }
}
