{
  "expo": {
    "name": "Handlis",
    "slug": "veckis",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/37425b58-c8af-45be-aac8-c26bbdfaa3d1"
    },
    "orientation": "default",
    "scheme": "handlis",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4e7a5e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.handlis.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.handlis.app",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4e7a5e"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#292524",
      "barStyle": "light-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-screen-orientation",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "@clerk/expo",
      "./plugins/withDisableAutofill",
      "./plugins/withSingleTask",
      [
        "expo-image-picker",
        {
          "photosPermission": "Handlis behöver tillgång till dina bilder för att välja receptbild.",
          "cameraPermission": "Handlis behöver kameran för att ta en receptbild."
        }
      ],
      "@clerk/expo-google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37425b58-c8af-45be-aac8-c26bbdfaa3d1"
      },
      "EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID": "630229510172-1nb18ugbraqrrqqcqgvvhblonslccr4f.apps.googleusercontent.com",
      "EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID": "630229510172-o5si76i2ce137204dtnbrjqbjmbccleq.apps.googleusercontent.com"
    },
    "owner": "joamel"
  }
}
